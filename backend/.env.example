APP_NAME="EduCreate Smart Class Agent"
APP_VERSION=0.1.0
# 前端开发地址（用于 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LLM 配置 ──────────────────────────────────────────────────────────────
# 当前使用的 LLM Provider（deepseek | openai）
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# OpenAI（备选 Provider）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── 数据库与文件 ─────────────────────────────────────────────────────────────
# 本地直接运行默认使用 SQLite；Docker Compose 会覆盖为 PostgreSQL + pgvector。
DATABASE_URL=sqlite:///./data/educreate.db
DATABASE_AUTO_CREATE=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AUTH_REQUIRED=false
JWT_SECRET=change-this-secret-in-production
DEMO_USERNAME=demo-teacher
DEMO_PASSWORD=change-me
