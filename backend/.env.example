APP_NAME="EduCreate Smart Class Agent"
APP_VERSION=0.1.0
# 前端开发地址（用于 CORS）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── LLM 配置 ──────────────────────────────────────────────────────────────
# 当前使用的 LLM Provider（deepseek | openai）
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# OpenAI（备选 Provider）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── 数据库与文件 ─────────────────────────────────────────────────────────────
# 本地直接运行默认使用 SQLite；Docker Compose 会覆盖为 PostgreSQL + pgvector。
DATABASE_URL=sqlite:///./data/educreate.db
DATABASE_AUTO_CREATE=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
# 本地默认同步解析，无需 Redis；需要调试 Worker 时再改为 true。
MATERIAL_ASYNC_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
MATERIAL_TASK_SOFT_LIMIT_SECONDS=1800
MATERIAL_TASK_HARD_LIMIT_SECONDS=1860
# 本地默认同步生成；Compose 使用现有 Celery Worker 异步生成 PPTX。
GENERATION_ASYNC_ENABLED=false
GENERATION_TASK_SOFT_LIMIT_SECONDS=300
GENERATION_TASK_HARD_LIMIT_SECONDS=330
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AUTH_REQUIRED=false
JWT_SECRET=change-this-secret-in-production
DEMO_USERNAME=demo-teacher
DEMO_PASSWORD=change-me
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=1024
BGE_MODEL_NAME=BAAI/bge-m3
OCR_ENABLED=true
OCR_LANGUAGE=chi_sim
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
OCR_MAX_PAGES=30
OCR_MAX_PIXELS=20000000
VIDEO_TRANSCRIPTION_ENABLED=false
VIDEO_WHISPER_MODEL=tiny
VIDEO_WHISPER_MODEL_PATH=
VIDEO_WHISPER_MODEL_CACHE_DIR=./data/whisper-models
VIDEO_ALLOW_MODEL_DOWNLOAD=false
VIDEO_WHISPER_DEVICE=cpu
VIDEO_WHISPER_COMPUTE_TYPE=int8
VIDEO_WHISPER_LANGUAGE=zh
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_TRANSCRIPTION_TIMEOUT_SECONDS=300
