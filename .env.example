# Docker Compose competition defaults.
# Copy this file to .env only when you need to override the local demo values.
POSTGRES_DB=educreate
POSTGRES_USER=educreate
POSTGRES_PASSWORD=educreate

# Compose 中材料解析固定通过 Redis + Celery Worker 执行。
MATERIAL_TASK_SOFT_LIMIT_SECONDS=1800
MATERIAL_TASK_HARD_LIMIT_SECONDS=1860

# LLM configuration (leave the key blank to use deterministic fallback mode)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AUTH_REQUIRED=false
JWT_SECRET=change-this-secret-in-production
DEMO_USERNAME=demo-teacher
DEMO_PASSWORD=change-me
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=1024
BGE_MODEL_NAME=BAAI/bge-m3
OCR_ENABLED=true
OCR_LANGUAGE=chi_sim
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
OCR_MAX_PAGES=30
OCR_MAX_PIXELS=20000000
VIDEO_TRANSCRIPTION_ENABLED=false
VIDEO_WHISPER_MODEL=tiny
VIDEO_WHISPER_MODEL_PATH=
VIDEO_WHISPER_MODEL_CACHE_DIR=./data/whisper-models
VIDEO_ALLOW_MODEL_DOWNLOAD=false
VIDEO_WHISPER_DEVICE=cpu
VIDEO_WHISPER_COMPUTE_TYPE=int8
VIDEO_WHISPER_LANGUAGE=zh
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_TRANSCRIPTION_TIMEOUT_SECONDS=300
